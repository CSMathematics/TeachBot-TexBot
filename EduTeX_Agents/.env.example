# EduTeX Backend Configuration

# 1. API Keys (Get yours from: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# 2. LLM Provider (gemini or openai)
LLM_PROVIDER=gemini

# 3. Model Selection
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o

# 4. Optional Settings
# LOG_LEVEL=INFO

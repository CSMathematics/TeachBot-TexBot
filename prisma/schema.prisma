// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────

enum Role {
  OWNER       // Can manage billing, invite members
  ADMIN       // Can manage content, classes
  TEACHER     // Can create content, assign to classes
  STUDENT     // Read-only (Consumer)
}

enum SyllabusType {
  SYSTEM        // Official National Curriculum (Read-only for most)
  ORGANIZATION  // Created by a School for its teachers
  PERSONAL      // Created by an individual teacher
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

// ─── Identity & Access Management ───────────────────────────────────

model Organization {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique // for subdomains or easy URLs
  subscriptionPlan SubscriptionPlan @default(FREE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users            User[]
  syllabuses       Syllabus[]
  classes          Class[]
  exercises        Exercise[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String?
  role           Role          @default(TEACHER)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Multi-tenancy
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Content
  createdSyllabuses Syllabus[]
  exercises         Exercise[]
}

// ─── Syllabus & Content ─────────────────────────────────────────────

model Syllabus {
  id           String       @id @default(uuid())
  name         String
  description  String?
  gradeLevel   String?      // e.g. "Α' Λυκείου", "Β' Λυκείου", "Γ' Λυκείου"
  type         SyllabusType
  isPublic     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Ownership
  ownerId      String?      // If Personal
  owner        User?        @relation(fields: [ownerId], references: [id])
  orgId        String?      // If Organization
  organization Organization? @relation(fields: [orgId], references: [id])

  // Version control
  clonedFromId String?      // ID of the Syllabus this was cloned from

  nodes        SyllabusNode[]
  classes      Class[]
}

model SyllabusNode {
  id          String   @id @default(uuid())
  syllabusId  String
  syllabus    Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)

  parentId    String?
  parent      SyllabusNode?  @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    SyllabusNode[] @relation("NodeHierarchy")

  title       String
  nodeType    String   // FIELD, CHAPTER, SECTION, PARAGRAPH, EXERCISE_GROUP
  contentType String?  // THEORY, METHODOLOGY (Applicable for PARAGRAPH)
  orderIndex  Int      // For sorting
  metadata    Json?    // Store tags, difficulty, etc.
  prerequisites String? // Free-text prerequisites (e.g. "Βασικά Όρια, Συνέχεια Συνάρτησης")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  exercises   Exercise[]
}

// ─── Class Management ───────────────────────────────────────────────

model Class {
  id           String   @id @default(uuid())
  name         String
  academicYear String

  // Ownership
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])

  // Curriculum
  syllabusId   String
  syllabus     Syllabus @relation(fields: [syllabusId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Members
  // students Student[] // TODO: Add Student model later
}

model ExerciseType {
  id          String   @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean  @default(false) // If true, available to everyone
  
  // Ownership (if custom type)
  ownerId     String?
  orgId       String?

  createdAt   DateTime @default(now())
  exercises   Exercise[]
}

model Exercise {
  id              String         @id @default(uuid())
  title           String?
  content         String         // The main LaTeX content
  difficulty      Int            @default(3) // 1-5 scale
  typeId          String?        
  exerciseType    ExerciseType?  @relation(fields: [typeId], references: [id])
  hasSolution     Boolean        @default(false)
  solution        String?        // LaTeX solution
  description     String?
  bibliography    String?
  tags            Json?          // Array of strings
  usageStatistics Int            @default(0) // incremented when added to exams/worksheets
  isPublic        Boolean        @default(false)
  
  // Relations
  ownerId         String?        
  owner           User?          @relation(fields: [ownerId], references: [id])
  orgId           String?
  organization    Organization?  @relation(fields: [orgId], references: [id])
  
  // Link to curriculum
  topicId         String?        
  topic           SyllabusNode?  @relation(fields: [topicId], references: [id])

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
